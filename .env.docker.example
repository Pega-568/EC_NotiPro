APP_ENV=production
POSTGRES_DB=ec_notipro
POSTGRES_USER=ec_notipro
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://ec_notipro:change-me@db:5432/ec_notipro
