FLASK_ENV=development
SECRET_KEY=change-me-in-production
DATABASE_URL=postgresql+psycopg://ec_notipro:ec_notipro@127.0.0.1:5432/ec_notipro
DB_POOL_RECYCLE_SECONDS=1800
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
APP_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
SESSION_TTL_MINUTES=480
LOGIN_LOCK_MINUTES=15
INTERNAL_BASE_URL=http://127.0.0.1:5000
FCM_ENABLED=false
FCM_SERVER_KEY=
FCM_ENDPOINT=https://fcm.googleapis.com/fcm/send
MAIL_ENABLED=false
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_FROM=notificaciones@ecuamatriz.local
MAIL_REPLY_TO=secretaria@ecuamatriz.local
MAIL_SUBJECT_PREFIX=[Ecuamatriz]
BACKGROUND_DISPATCH_ENABLED=true
BACKGROUND_DISPATCH_INTERVAL_SECONDS=30
