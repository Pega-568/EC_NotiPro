APP_ENV=development
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/dbname
TEST_DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/dbname_test
SECRET_KEY=
DB_POOL_RECYCLE_SECONDS=1800
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
APP_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
SESSION_TTL_MINUTES=480
LOGIN_LOCK_MINUTES=15
INTERNAL_BASE_URL=http://127.0.0.1:5000
FCM_ENABLED=false
FCM_SERVICE_ACCOUNT_PATH=
BACKGROUND_DISPATCH_ENABLED=false
BACKGROUND_DISPATCH_INTERVAL_SECONDS=30
MAIL_ENABLED=false
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_FROM=notificaciones@ecuamatriz.local
MAIL_REPLY_TO=secretaria@ecuamatriz.local
MAIL_SUBJECT_PREFIX=[Ecuamatriz]
LOG_LEVEL=INFO
LOG_FILE=
ALLOW_DEMO_SEED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
