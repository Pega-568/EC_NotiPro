SESSION_COOKIE_SAMESITE=Lax
APP_ALLOWED_ORIGINS=https://TU_DOMINIO
INTERNAL_BASE_URL=https://TU_DOMINIO
MAIL_ENABLED=false
LOG_LEVEL=INFO
LOG_FILE=
ALLOW_DEMO_SEED=false
ADMIN_EMAIL=
