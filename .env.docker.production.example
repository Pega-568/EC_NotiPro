APP_ENV=production
POSTGRES_DB=ec_notipro
POSTGRES_USER=ec_notipro
POSTGRES_PASSWORD=CAMBIAR
DATABASE_URL=postgresql+psycopg://ec_notipro:CAMBIAR@db:5432/ec_notipro
TEST_DATABASE_URL=postgresql+psycopg://ec_notipro:CAMBIAR@db:5432/ec_notipro_test
SECRET_KEY=CAMBIAR
FCM_ENABLED=true
FCM_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-service-account.json
BACKGROUND_DISPATCH_ENABLED=true
