[Unit]
Description=EC_NotiPro Gunicorn Service
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/ec-notipro
EnvironmentFile=/etc/ec-notipro/.env
ExecStart=/opt/ec-notipro/.venv/bin/gunicorn --workers 3 --bind 127.0.0.1:8000 run:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
